import os
import re
import chess.pgn

# Output PGN files
output_files = {
    "bullet": open("cc-bullet.pgn", "w"),
    "blitz": open("cc-blitz.pgn", "w"),
    "rapid": open("cc-rapid.pgn", "w"),
    "daily": open("cc-daily.pgn", "w"),
}
skipped_file = open("cc-skipped.pgn", "w")
setup_file = open("cc-setup.pgn", "w")
chess960_file = open("cc-chess960.pgn", "w")

# Mapping filenames for cleanup
file_paths = {
    "bullet": "cc-bullet.pgn",
    "blitz": "cc-blitz.pgn",
    "rapid": "cc-rapid.pgn",
    "daily": "cc-daily.pgn",
    "setup": "cc-setup.pgn",
    "chess960": "cc-chess960.pgn",
    "skipped": "cc-skipped.pgn",
}

# Counters
game_counts = {
    "bullet": 0,
    "blitz": 0,
    "rapid": 0,
    "daily": 0,
    "setup": 0,
    "chess960": 0,
    "skipped": 0
}
total_games = 0

# Match PGN archive filenames like Mouselip_2024-06.pgn
archive_pattern = re.compile(r"^[\w-]+_\d{4}-\d{2}\.pgn$")

# Classify by TimeControl only
def classify_game(game):
    tc = game.headers.get("TimeControl", "").strip()

    if not tc or tc in ("-", "?"):
        return None

    try:
        if tc.startswith("1/"):
            return "daily"

        if "+" in tc:
            base, inc = map(int, tc.split("+"))
        else:
            base = int(tc)
            inc = 0

        estimated = base + 40 * inc

        if estimated < 180:
            return "bullet"
        elif estimated < 600:
            return "blitz"
        else:
            return "rapid"

    except Exception:
        return None

# Process PGNs
for filename in os.listdir("."):
    if archive_pattern.match(filename):
        with open(filename, "r", encoding="utf-8") as f:
            while True:
                try:
                    game = chess.pgn.read_game(f)
                except Exception:
                    break
                if game is None:
                    break

                total_games += 1
                event = game.headers.get("Event", "").lower()
                variant = game.headers.get("Variant", "").lower()

                # ✅ Chess960 first
                if variant == "chess960":
                    print(f"[Chess960] Game {total_games}: {event}")
                    game_counts["chess960"] += 1
                    print(game, file=chess960_file)
                    continue

                # ✅ Setup games
                if game.headers.get("SetUp", "") == "1":
                    print(f"[Setup] Game {total_games}: {event}")
                    game_counts["setup"] += 1
                    print(game, file=setup_file)
                    continue

                # ⛔ Skip odds chess and unrated
                if "odds chess" in event or event.startswith("unrated"):
                    print(f"[Skipped] Game {total_games}: {event}")
                    game_counts["skipped"] += 1
                    print(game, file=skipped_file)
                    continue

                kind = classify_game(game)
                if kind and kind in output_files:
                    tc = game.headers.get("TimeControl", "")
                    print(f"[{kind.capitalize()}] Game {total_games}: TimeControl={tc}")
                    print(game, file=output_files[kind])
                    game_counts[kind] += 1
                else:
                    print(f"[Skipped] Game {total_games}: Could not classify")
                    game_counts["skipped"] += 1
                    print(game, file=skipped_file)

# Close files
for f in output_files.values():
    f.close()
setup_file.close()
chess960_file.close()
skipped_file.close()

# ✅ Delete empty PGN files
for key, path in file_paths.items():
    if game_counts[key] == 0:
        try:
            os.remove(path)
        except FileNotFoundError:
            pass

# Summary
print("\nDone. Games split into:")
print(f"  Bullet:    {game_counts['bullet']}")
print(f"  Blitz:     {game_counts['blitz']}")
print(f"  Rapid:     {game_counts['rapid']}")
print(f"  Daily:     {game_counts['daily']}")
print(f"  Setup:     {game_counts['setup']}")
print(f"  Chess960:  {game_counts['chess960']}")
print(f"  Skipped:   {game_counts['skipped']}")

